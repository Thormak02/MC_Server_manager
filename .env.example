# Example environment configuration

MCSM_SECRET_KEY=CHANGE_ME_IN_ENV
MCSM_INITIAL_SUPERADMIN_USERNAME=admin
MCSM_INITIAL_SUPERADMIN_PASSWORD=admin123!

# Security / Session
MCSM_SESSION_IDLE_TIMEOUT_SECONDS=1800
MCSM_CSRF_PROTECTION_ENABLED=true
MCSM_SECURITY_LOG_IP=true
MCSM_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
MCSM_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8
MCSM_LOGIN_LOCKOUT_SECONDS=900
MCSM_PASSWORD_MIN_LENGTH=10
MCSM_PASSWORD_REQUIRE_UPPERCASE=true
MCSM_PASSWORD_REQUIRE_LOWERCASE=true
MCSM_PASSWORD_REQUIRE_DIGIT=true

# Database
MCSM_SQLITE_PATH=data/mc_server_manager.db

# Scheduler / restart behaviour
MCSM_SCHEDULER_TIMEZONE=Europe/Berlin
MCSM_INGAME_RESTART_DELAY_SECONDS=30
MCSM_INGAME_RESTART_WARNING_MESSAGE=Server restartet in {seconds} Sekunden aufgrund /restart.

# Provisioning
MCSM_PROVISIONING_OFFLINE_MODE=false
MCSM_DEFAULT_SERVER_ROOT=
MCSM_DEFAULT_BACKUP_ROOT=

# External APIs
MCSM_MODRINTH_ENABLED=true
MCSM_CURSEFORGE_API_KEY=CHANGE_ME
MCSM_CURSEFORGE_ENABLED=true
MCSM_MODRINTH_USER_AGENT=mc-server-manager/1.0
# Optional TLS overrides for environments with custom/proxy certificates
# MCSM_TLS_CA_BUNDLE_PATH=C:\path\to\ca-bundle.pem
# MCSM_TLS_SKIP_VERIFY=false

# Public manager URL (self-hosted resource packs), e.g. http://your-domain:8000
# MCSM_PUBLIC_BASE_URL=

# Lobby / Gateway routing (one MC entrypoint -> route by hostname alias).
# All three are also editable under Settings -> Lobby/Gateway (UI overrides ENV).
MCSM_GATEWAY_ENABLED=false
MCSM_GATEWAY_PORT=25565
# Target domain only for display of connection addresses (<alias>.<domain>)
MCSM_GATEWAY_DOMAIN=
